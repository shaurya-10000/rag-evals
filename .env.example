# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_evals

# LLM
GEMINI_API_KEY=your-gemini-key

# API security (must match the frontend web/.env.local values)
RAG_API_KEY=your-random-32-char-string
JWT_SECRET=your-random-32-char-string

# development | production (production rejects the dev default secrets)
ENVIRONMENT=development

# Public URLs, used in email links and the Google OAuth redirect.
# Use your deployed URLs in production.
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Email via Brevo's transactional API. EMAIL_FROM_ADDRESS must be a sender verified in Brevo.
# If BREVO_API_KEY is empty in development, verification/reset links are printed to the
# backend console instead of being emailed.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=RAG Evals

# Google OAuth (leave empty to disable Google sign-in).
# Register this redirect URI on the OAuth client: <BACKEND_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
