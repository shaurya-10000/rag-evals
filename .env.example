# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_evals

# LLM
GEMINI_API_KEY=your-gemini-key

# API security (must match the frontend web/.env.local values)
RAG_API_KEY=your-random-32-char-string
JWT_SECRET=your-random-32-char-string

# development | production (production rejects the dev default secrets)
ENVIRONMENT=development